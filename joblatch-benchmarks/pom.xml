<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.math3wsl3vi</groupId>
        <artifactId>joblatch-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>joblatch-benchmarks</artifactId>
    <name>joblatch-benchmarks</name>
    <description>Benchmarks: JobLatch vs db-scheduler on the same machine and database. Never published.</description>

    <properties>
        <maven.deploy.skip>true</maven.deploy.skip>
        <!-- Workload size. Override on the command line, e.g. -Dbench.jobs=20000 -->
        <bench.jobs>10000</bench.jobs>
        <bench.reps>3</bench.reps>
    </properties>

    <dependencies>
        <dependency>
            <groupId>io.github.math3wsl3vi</groupId>
            <artifactId>joblatch-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.github.kagkarlsson</groupId>
            <artifactId>db-scheduler</artifactId>
        </dependency>
        <dependency>
            <groupId>com.zaxxer</groupId>
            <artifactId>HikariCP</artifactId>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
        </dependency>
        <!-- Starts a throwaway Postgres for each run. Compile scope: the benchmark is a program. -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
              Run:  ./mvnw -pl joblatch-benchmarks -am install -DskipTests
                    ./mvnw -pl joblatch-benchmarks exec:exec
              exec:exec starts a SEPARATE JVM. Running inside Maven's own JVM (exec:java) would mix
              Maven's heap and threads into the measurements.
            -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <configuration>
                    <executable>${java.home}/bin/java</executable>
                    <arguments>
                        <!-- Fixed heap: no resizing during runs, same for every system. -->
                        <argument>-Xms1g</argument>
                        <argument>-Xmx1g</argument>
                        <argument>-Dbench.jobs=${bench.jobs}</argument>
                        <argument>-Dbench.reps=${bench.reps}</argument>
                        <argument>-classpath</argument>
                        <classpath/>
                        <argument>dev.joblatch.bench.BenchmarkMain</argument>
                    </arguments>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
