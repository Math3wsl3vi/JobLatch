<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.math3wsl3vi</groupId>
        <artifactId>joblatch-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>joblatch-demo</artifactId>
    <name>joblatch-demo</name>
    <description>Runnable example: transactional enqueue, an idempotent handler, a worker pool and a reaper.</description>

    <properties>
        <!-- Demo app is never published. -->
        <maven.deploy.skip>true</maven.deploy.skip>
    </properties>

    <dependencies>
        <dependency>
            <groupId>io.github.math3wsl3vi</groupId>
            <artifactId>joblatch-core</artifactId>
        </dependency>
        <!-- A real connection pool, as a production application would use. -->
        <dependency>
            <groupId>com.zaxxer</groupId>
            <artifactId>HikariCP</artifactId>
        </dependency>
        <!-- An application picks its own logging backend. JobLatch only uses the SLF4J API. -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
              Run (needs the database from docker-compose.yml and the JOBLATCH_* variables, see README):
                ./mvnw -pl joblatch-demo -am install -DskipTests
                ./mvnw -pl joblatch-demo exec:exec
              exec:exec starts a separate JVM, which inherits the JOBLATCH_* environment variables.
            -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <configuration>
                    <executable>${java.home}/bin/java</executable>
                    <arguments>
                        <argument>-classpath</argument>
                        <classpath/>
                        <argument>dev.joblatch.demo.DemoApplication</argument>
                    </arguments>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
