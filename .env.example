# Copy to .env and change the password. .env is git-ignored; this example file is not.
POSTGRES_USER=joblatch
POSTGRES_PASSWORD=change-me-to-something-long-and-random
# Change if port 5432 is already in use on your machine.
JOBLATCH_PG_PORT=5432

# Read by joblatch-demo (and any app you build). Export them in your shell, e.g.:
#   set -a; source .env; set +a
JOBLATCH_DB_URL=jdbc:postgresql://localhost:5432/joblatch
JOBLATCH_DB_USER=joblatch
JOBLATCH_DB_PASSWORD=change-me-to-something-long-and-random
