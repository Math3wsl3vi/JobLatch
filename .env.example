# Copy to .env and change the password. .env is git-ignored; this example file is not.
POSTGRES_USER=foleni
POSTGRES_PASSWORD=change-me-to-something-long-and-random
# Change if port 5432 is already in use on your machine.
FOLENI_PG_PORT=5432

# Read by foleni-demo (and any app you build). Export them in your shell, e.g.:
#   set -a; source .env; set +a
FOLENI_DB_URL=jdbc:postgresql://localhost:5432/foleni
FOLENI_DB_USER=foleni
FOLENI_DB_PASSWORD=change-me-to-something-long-and-random
